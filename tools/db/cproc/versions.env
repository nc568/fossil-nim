# Pinned toolchain for the cproc gate. Bumping any of these is a decision, not
# an accident: `tools/db/cproc/versions.sh` compares the installed toolchain
# against these numbers and fails loudly on a mismatch.
#
# Why pin at all: cproc emits `loadw extern $g`, which only QBE >= 1.3 parses.
# That single version skew cost a week of "cproc is broken" reports about a
# compiler that was working correctly (K9L-35).
NIM_VERSION=2.2.12
QBE_VERSION=1.3
CPROC_COMMIT=d1c53dd
MUSL_VERSION=1.2.5
